# Окружение приложения: dev | test | prod
APP_ENV=
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
# Токен бота от @BotFather (ТЗ 9: только через переменные окружения)
BOT_TOKEN=
# Telegram id первых владельцев через запятую, например: 111,222
# Одноразовый триггер мастера «Создать заведение» (решение A3), не источник прав
OWNER_TELEGRAM_IDS=
# postgresql+asyncpg://user:password@host:5432/barpoint
# Локальный запуск (`.venv/bin/python -m src.bot`) и pytest берут строку отсюда.
# Внутри docker compose она подменяется на хост `postgres` — см. docker-compose.yml.
DATABASE_URL=
# redis://host:6379/0
REDIS_URL=

# --- только для docker compose -------------------------------------------------------
# Учётные данные контейнера postgres; из них же собирается DATABASE_URL внутри compose.
# Если не заданы, compose подставит barpoint/barpoint/barpoint.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
