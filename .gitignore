# Secrets (TZ 9). Only .env.example is committed; the filled-in files never are.
.env
.env.local
.env.*.local

# Virtualenv and bytecode
.venv/
__pycache__/
*.pyc

# Tool caches. Every one of them appears in the repository root after a normal
# `ruff check . && mypy && pytest` run. They stay out of `git status` today only because
# each tool writes its own .gitignore inside its cache directory -- an external guarantee
# that disappears with a tool upgrade or a manually created directory.
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Build artefacts of `pip install -e .` and `pip wheel .` (plan, task 10)
build/
dist/
*.egg-info/

# Coverage
.coverage
.coverage.*
htmlcov/

# macOS
.DS_Store

# Reference workbook. TZ 1.6 asks for it to live in tests/fixtures/reference/, and that is
# where it sits on disk -- but this repository is PUBLIC, and the workbook carries a real
# bar's commercial data: supplier contact names with mobile numbers, purchase prices and
# cost margins. Committing it would publish someone else's personal and commercial data.
# Keep it local until the repository is made private (then delete these two lines) or the
# file is sanitised. See docs/schema-notes.md.
tests/fixtures/reference/Invasion.xlsx
