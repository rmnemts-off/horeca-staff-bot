# Secrets (TZ 9). Only .env.example is committed; the filled-in files never are.
.env
.env.local
.env.*.local

# Virtualenv and bytecode
.venv/
__pycache__/
*.pyc

# Tool caches. Every one of them appears in the repository root after a normal
# `ruff check . && mypy && pytest` run. They stay out of `git status` today only because
# each tool writes its own .gitignore inside its cache directory -- an external guarantee
# that disappears with a tool upgrade or a manually created directory.
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Build artefacts of `pip install -e .` and `pip wheel .` (plan, task 10)
build/
dist/
*.egg-info/

# Coverage
.coverage
.coverage.*
htmlcov/

# macOS
.DS_Store

# Reference workbook. The repository is PUBLIC, so only the sanitised copy is committed:
# tests/fixtures/reference/Invasion.xlsx, produced by tests/tools/sanitize_reference.py.
# The untouched original carries a real bar's supplier contacts with mobile numbers,
# purchase prices and cost margins -- it stays on the maintainer's disk and never leaves it.
tests/fixtures/reference/*.original.xlsx
